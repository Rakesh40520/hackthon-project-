# ClauseGuard environment configuration
# Copy this file to `.env` and fill in your values. Never commit real secrets.

# --- Required for LIVE LLM extraction (demo mode works without it) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Optional: any OpenAI-compatible endpoint ---
# Works with OpenAI by default. For other providers (Groq, Together, Ollama,
# OpenRouter, Azure gateways...), point this at their OpenAI-compatible URL.
# LLM_BASE_URL=https://api.openai.com/v1

# --- Optional overrides ---
# Chat model used for extraction.
# LLM_MODEL=gpt-4o-mini
# Request timeout in seconds.
# LLM_TIMEOUT=120
