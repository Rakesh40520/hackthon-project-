# Application
APP_NAME=Procurement Intelligence Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Security
SECRET_KEY=change-me-in-production-this-must-be-very-long-and-random-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://procurement:procurement@postgres:5432/procurement
DATABASE_URL_SYNC=postgresql://procurement:procurement@postgres:5432/procurement

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".docx",".xlsx",".csv",".txt"]

# AI Provider: openai | anthropic | gemini | ollama | mock
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://localhost:11434

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
